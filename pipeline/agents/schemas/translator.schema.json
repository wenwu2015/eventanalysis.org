{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["agentVersion", "editions"],
  "properties": { "agentVersion": { "type": "string" }, "editions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/localizedEdition" } } }, "additionalProperties": false,
  "$defs": {
    "localizedEdition": { "type": "object", "required": ["locale", "edition"], "properties": { "locale": { "type": "string" }, "edition": { "$ref": "#/$defs/edition" } }, "additionalProperties": false },
    "paragraph": { "type": "object", "required": ["text", "claimRefs"], "properties": { "text": { "type": "string" }, "claimRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } } }, "additionalProperties": false },
    "section": { "type": "object", "required": ["id", "title", "paragraphs"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "paragraphs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/paragraph" } } }, "additionalProperties": false },
    "timelineItem": { "type": "object", "required": ["minute", "label", "claimRefs"], "properties": { "minute": { "type": "string" }, "label": { "type": "string" }, "claimRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } } }, "additionalProperties": false },
    "edition": { "type": "object", "required": ["slug", "title", "deck", "competition", "venue", "homeName", "awayName", "resultLabel", "sections", "timeline"], "properties": { "slug": { "type": "string" }, "title": { "type": "string" }, "deck": { "type": "string" }, "competition": { "type": "string" }, "venue": { "type": "string" }, "homeName": { "type": "string" }, "awayName": { "type": "string" }, "resultLabel": { "type": "string" }, "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }, "timeline": { "type": "array", "items": { "$ref": "#/$defs/timelineItem" } } }, "additionalProperties": false }
  }
}
