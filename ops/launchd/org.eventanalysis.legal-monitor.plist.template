<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.eventanalysis.legal-monitor</string>
  <key>ProgramArguments</key><array><string>__NPM__</string><string>run</string><string>legal:check</string></array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>__PATH__</string></dict>
  <key>StartCalendarInterval</key><dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__ROOT__/pipeline/runtime/launchd/legal.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/pipeline/runtime/launchd/legal.error.log</string>
</dict></plist>
